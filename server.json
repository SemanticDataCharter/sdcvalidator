{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SemanticDataCharter/sdcvalidator",
  "description": "SDC4 structural validator with ExceptionalValue recovery; thin wrapper over xmlschema.",
  "repository": {
    "url": "https://github.com/SemanticDataCharter/sdcvalidator",
    "source": "github"
  },
  "version": "4.6.2",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "sdcvalidator",
      "version": "4.6.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the MCP stdio server rather than the CLI help."
        }
      ]
    }
  ]
}
